# Heavy per-cell scratch for the skglm controlled experiment; reproducible
# from results/skglm-controlled/index.csv via sim-skglm-controlled-problem.jl.
/results/skglm-controlled/cells/

# Per-cell checkpoints for the centering sweep; the large-alpha cells run tens
# of thousands of passes, so sim-rho-centering.jl resumes from these instead of
# recomputing. The assembled results/rho-centering.jld2 is the tracked artifact.
/results/rho-centering/cells/

# Heavy design matrices for the production-solver problems; reproducible
# from experiments/sim-real-problem.jl. y.csv and meta.json are small
# enough to keep tracked for documentation of the (n, p, lambda, mu0) cells.
/results/real-solvers/X.csv
/results/real-solvers/*/X.csv
/results/real-solvers-poisson/*/X.csv

# Real-data inputs: large files retrieved from the pinned Zenodo archive via
# experiments/fetch-data.sh (and rebuilt by experiments/build-data-archive.jl).
# Only the small checksum manifest, the dataset manifest, and the README are
# tracked; the data files themselves are ignored. The cached results/ render
# the paper without them.
/data/*
!/data/README.md
!/data/MANIFEST.sha256
!/data/libsvm/
/data/libsvm/*
!/data/libsvm/manifest.json

# Upload-ready data archive produced by experiments/build-data-archive.jl.
/intercepts-data-*.tar.gz

# Dev-facing figure previews from `task fig`. The CSV summaries next to them are
# tracked on purpose --- their diffs show which figures moved after a re-run ---
# but the PNGs are binary churn.
/results/figure-tables/png/
/.agents/scheduled_tasks.lock
/.agents/settings.local.json
